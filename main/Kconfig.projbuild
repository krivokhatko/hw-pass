menu "hw-pass"

    choice HWPASS_BOARD
        prompt "Board"
        default HWPASS_BOARD_STICKS3
        help
            The hardware that runs the firmware. Each board has a file
            boards/<name>.defaults that selects it. The CI builds a
            release for each board. "info" shows the board name.

        config HWPASS_BOARD_STICKS3
            bool "M5Stack StickS3"
    endchoice

    config HWPASS_BOARD_NAME
        string
        default "sticks3" if HWPASS_BOARD_STICKS3

    config HWPASS_WEB
        bool "Wi-Fi setup mode with a web page"
        default y
        help
            Both buttons start a Wi-Fi access point with a web page that
            changes the entries. Turn this off for a build without the page.

    config HWPASS_NTP
        bool "Time sync with the NTP server of the Wi-Fi router"
        default y
        help
            The device joins the Wi-Fi network for some seconds, gets the
            time from the router, and turns the radio off again. Turn this
            and HWPASS_WEB off for a build without Wi-Fi.

endmenu
