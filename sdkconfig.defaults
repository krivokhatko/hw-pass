# Project configuration for all boards. The board file (boards/<name>.defaults)
# names the chip and the board; ESP-IDF then also reads sdkconfig.defaults.<chip>
# (the console, the flash size, the partition table, the USB device, and the
# Bluetooth controller of the chip). A build without a board file is a build
# for the StickS3 (CMakeLists.txt).
CONFIG_PARTITION_TABLE_CUSTOM=y
# 1 ms tick for key timing and button sampling.
CONFIG_FREERTOS_HZ=1000
# Battery: the CPU runs at 80 MHz while all tasks wait, and at the default
# frequency while a task runs (esp_pm_configure in main.c). No light
# sleep: USB and the backlight PWM need the clocks.
CONFIG_PM_ENABLE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
# The schedule of the mouse mover runs in the esp_timer task and saves
# the state to NVS there.
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096
# Wi-Fi setup mode. Each start makes a new password: keep no Wi-Fi data in NVS.
CONFIG_ESP_WIFI_NVS_ENABLED=n
# Browsers send long request headers.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
# Bluetooth LE: NimBLE host with two links. Central role: the keypad.
# Peripheral role: the device is a keyboard and a mouse for a computer
# (HID over GATT) and advertises for it. The GATT server also answers the
# requests of the keypad (the FBK21C looks for an iPhone service; without
# an answer in 30 s, it sends no more keys). Bonds: the keypad, the
# computer, and one more during a new pairing. Bonding keys stay in NVS.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_BT_NIMBLE_MAX_BONDS=3
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
# Debug logs show the keys of the link.
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
# Small pools: two links, the advertising, and one scan or connection
# attempt at a time.
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=10
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=16

# Wi-Fi and Bluetooth together need the RAM. Wi-Fi code runs from flash:
# the setup page needs no speed. One station needs few RX buffers.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=5
