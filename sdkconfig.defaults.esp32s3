# ESP32-S3 (StickS3, Chain Dual Key, StampS3A): 8 MB flash. ESP-IDF reads
# this file after sdkconfig.defaults when the chip is the ESP32-S3.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# UART0 is not wired to USB; use the built-in USB Serial/JTAG as console.
# The application gives the USB PHY to TinyUSB after start-up.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# USB device: HID keyboard, CDC-ACM serial port, and HID mouse.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_HID_COUNT=2
CONFIG_TINYUSB_DEBUG_LEVEL=0
# Bluetooth controller: two links, the advertising, and one scan or
# connection attempt at a time. Each activity takes 828 bytes.
CONFIG_BT_CTRL_BLE_MAX_ACT=5
