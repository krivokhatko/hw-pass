# StickS3: ESP32-S3-PICO-1, 8 MB flash.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# UART0 is not wired to USB; use the built-in USB Serial/JTAG as console.
# The application gives the USB PHY to TinyUSB after start-up.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# 1 ms tick for key timing and button sampling.
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
# USB device: HID keyboard and CDC-ACM serial port.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_HID_COUNT=1
CONFIG_TINYUSB_DEBUG_LEVEL=0
# Wi-Fi setup mode. Each start makes a new password: keep no Wi-Fi data in NVS.
CONFIG_ESP_WIFI_NVS_ENABLED=n
# Browsers send long request headers.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
# Bluetooth LE keypad: NimBLE host, central role. One link, one bond
# and one more during a new pairing. Bonding keys stay in NVS.
# The keypad also sends requests to the device (the FBK21C looks for an
# iPhone service). If no answer comes in 30 s, the keypad sends no more
# keys. The GATT server answers; it needs the peripheral role. The device
# does not advertise: no other device can connect to it.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=2
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
# Debug logs show the keys of the link.
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
# Small pools: one link, one scan or connection at a time.
CONFIG_BT_CTRL_BLE_MAX_ACT=3
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=10
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=16

# Wi-Fi and Bluetooth together need the RAM. Wi-Fi code runs from flash:
# the setup page needs no speed. One station needs few RX buffers.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=5
